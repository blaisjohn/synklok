<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the Windows app build on macOS/Linux; it still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Synklok</AssemblyName>
    <RootNamespace>Synklok.Tray</RootNamespace>
    <ApplicationIcon>Assets\synklok.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Product>Synklok</Product>
    <Copyright>© 2026 John Blais. MIT License.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Synklok.Core\Synklok.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\*.ico" />
  </ItemGroup>

</Project>
